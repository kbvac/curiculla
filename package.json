{
  "name": "curricula",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:assessments": "tsx prisma/seed/assessments.ts",
    "catalog:build": "tsx prisma/seed/catalog.ts",
    "import:ucsd:lectures": "tsx prisma/seed/import-ucsd-lectures.ts",
    "setup": "npm run seed && npm run catalog:build && npm run seed:assessments && npm run import:ucsd:lectures",
    "promote": "tsx prisma/seed/promote.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "google-auth-library": "^11.0.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
